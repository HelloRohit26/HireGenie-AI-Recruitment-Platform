# HireGenie AI Environment Configuration Example

APP_NAME=HireGenie AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=production

# Production Database (PostgreSQL Required)
# Format: postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/hiregenie_db

SECRET_KEY=your_super_secret_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email Delivery Provider Configuration ──────────────────────────────────
# Active provider choice: 'auto' (default), 'resend', 'smtp', or 'sendgrid'
EMAIL_PROVIDER=auto

# Provider 1: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Provider 2: SMTP (Standard TLS/SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@hiregenie.ai
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Provider 3: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@hiregenie.ai

# Test Recipient (Optional default for test email endpoint)
TEST_EMAIL_RECIPIENT=your_test_email@example.com

# ── Sarvam AI Voice Interview Engine Configuration ─────────────────────────
# Required for Real-Time Speech-to-Text (STT) and Text-to-Speech (TTS) voice interviews
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_SPEAKER=meera

# ── LiveKit WebRTC Real-Time Transport Configuration ────────────────────────
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ── CORS Configuration ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ── Durable Worker Queue & Redis Configuration (Step 7B) ───────────────────
DURABLE_QUEUE_ENABLED=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False


